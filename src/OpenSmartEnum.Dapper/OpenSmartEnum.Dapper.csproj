<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<PackageId>OpenSmartEnum.Dapper</PackageId>
		<Title>OpenSmartEnum.Dapper</Title>
		<Description>Dapper support for OpenSmartEnum.</Description>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Summary>Dapper support for OpenSmartEnum.</Summary>
		<PackageTags>enum;smartenum;dapper</PackageTags>
		<PackageReleaseNotes>
      The change log and breaking changes are listed here.
      https://github.com/bandoyer/OpenSmartEnum/blob/main/CHANGELOG.md
    </PackageReleaseNotes>
		<AssemblyName>OpenSmartEnum.Dapper</AssemblyName>
		<RootNamespace>OpenSmartEnum.Dapper</RootNamespace>
		<AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
	</PropertyGroup>
	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
	<ItemGroup>
	  <PackageReference Include="Dapper" />
	</ItemGroup>
	<ItemGroup>
	  <ProjectReference Include="..\OpenSmartEnum\OpenSmartEnum.csproj" />
	</ItemGroup>
</Project>
