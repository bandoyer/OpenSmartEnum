<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<PackageId>OpenSmartEnum.JsonNet</PackageId>
		<Title>OpenSmartEnum.JsonNet</Title>
		<Description>Json.NET (de)serialization support for OpenSmartEnum.</Description>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Summary>Json.NET (de)serialization support for OpenSmartEnum.</Summary>
		<PackageTags>enum;smartenum;json;json.net;converter</PackageTags>
		<PackageReleaseNotes>
      The change log and breaking changes are listed here.
      https://github.com/bandoyer/OpenSmartEnum/blob/main/CHANGELOG.md
    </PackageReleaseNotes>
		<AssemblyName>OpenSmartEnum.JsonNet</AssemblyName>
		<RootNamespace>OpenSmartEnum.JsonNet</RootNamespace>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Newtonsoft.Json" />
	</ItemGroup>
	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\OpenSmartEnum\OpenSmartEnum.csproj" />
	</ItemGroup>
</Project>
